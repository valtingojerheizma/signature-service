# =============================================================================
# SignatureOps Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://signatureops:signatureops_dev_password@localhost:5432/signatureops

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-minimum-32-characters-long

# -----------------------------------------------------------------------------
# Google OAuth (for admin sign-in)
# -----------------------------------------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Set authorized redirect URI to: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Encryption (for service account credentials)
# -----------------------------------------------------------------------------
# Generate a secure random string: openssl rand -base64 32
ENCRYPTION_MASTER_SECRET=your-encryption-master-secret-32-chars-min
ENCRYPTION_KEY_ID=key_001

# -----------------------------------------------------------------------------
# S3-Compatible Storage (MinIO for local dev)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=signatureops-assets
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/signatureops-assets

# For production with AWS S3:
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY=your-aws-access-key
# S3_SECRET_KEY=your-aws-secret-key
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_PUBLIC_URL=https://your-bucket-name.s3.amazonaws.com

# -----------------------------------------------------------------------------
# Stripe Billing
# -----------------------------------------------------------------------------
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_ID=price_your-price-id

# For production:
# STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-production-webhook-secret

# -----------------------------------------------------------------------------
# Development Options
# -----------------------------------------------------------------------------
# Set to "true" to use mock Google APIs (no real credentials needed)
MOCK_GOOGLE_MODE=true

# Logging level: debug, info, warn, error
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Production Overrides
# -----------------------------------------------------------------------------
# NODE_ENV=production
# NEXTAUTH_URL=https://your-production-domain.com
